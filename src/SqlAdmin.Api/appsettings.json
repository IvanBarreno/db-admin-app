{
  // appsettings.json — application settings that are NOT server definitions.
  // (Server definitions live in servers.json / servers.local.json, added in Phase 1.)
  // ASP.NET Core reads this file, then appsettings.{Environment}.json, then environment variables,
  // then command-line args — later sources override earlier ones.

  "Kestrel": {
    // Kestrel is the built-in web server.
    // SECURITY: bind to loopback ONLY. The API runs SQL with the DBA's own credentials and has
    // no authentication layer of its own, so it must never be reachable from the network.
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:5000"
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Host header filtering. With a loopback-only binding this is belt-and-braces,
  // but it stops anything that isn't addressed to localhost from being processed.
  "AllowedHosts": "localhost;127.0.0.1"
}
