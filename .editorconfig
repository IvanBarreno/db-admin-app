# .editorconfig — shared formatting rules that VS Code, Visual Studio and Rider all honour.
# `dotnet format` also uses this file, so the whole team gets identical style with zero discussion.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml,js,jsx,ts,tsx,css,html,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------- C# style ----------
[*.cs]
# File-scoped namespaces: `namespace X;` instead of `namespace X { ... }` — one less indent level.
csharp_style_namespace_declarations = file_scoped:warning
# Prefer `var` when the type is obvious from the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
# Use expression-bodied members for one-liners.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
# Braces on their own line (classic C# / Allman style).
csharp_new_line_before_open_brace = all
# Sort `using System.*` first, then others.
dotnet_sort_system_directives_first = true
# Naming: private fields start with underscore (_fooBar).
dotnet_naming_rule.private_fields_underscore.symbols  = private_fields
dotnet_naming_rule.private_fields_underscore.style    = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds           = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization  = camel_case
